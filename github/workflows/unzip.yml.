name: Unzip batches
on: workflow_dispatch
permissions:
  contents: write
jobs:
  unzip:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Unpack batch zips into the site and remove them
        run: |
          for z in batch-*.zip; do unzip -o -q "$z" -d .; done
          rm -f batch-*.zip
          touch .nojekyll
      - name: Commit result
        run: |
          git config user.name "github-actions"
          git config user.email "github-actions@users.noreply.github.com"
          git add -A
          git commit -m "Unpack site files from batches"
          git push
